# Phase 12 — Kubernetes platform toolchain pins.
#
# Every version was verified against the publisher's checksum at the S1 gate on
# 2026-11-20. Checksums are recorded per platform so the local Windows run and
# the Linux CI run each verify against the artefact they actually download.
# See docs/phase-12-kubernetes-platform.md §4.
#
# Format: shell-style KEY=VALUE. No secret material belongs here.

# Kubernetes baseline and the schema matrix validated by kubeconform.
KUBERNETES_BASELINE=1.35.8
KUBECONFORM_VERSIONS=1.35.0,1.36.0,1.37.0

# kind and its node image.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
KIND_WINDOWS_AMD64_SHA256=4b22adaa135368c5a465d56bbd8e520cbea87272a06ca00b6078e7b81515c9fc
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_DARWIN_ARM64_SHA256=0c8c7dbe5e23594a198b786c4bc13dacc101fa6196b0cb0b23a1ca44e61f4b4f

# kubectl. v1.30.2 is five minors behind the 1.35 API server and outside the
# supported +/-1 skew; v1.35.8 is mandatory.
KUBECTL_VERSION=v1.35.8
KUBECTL_WINDOWS_AMD64_SHA256=f675d70224b42b84e0442e8d7644efbe440e4451a4b02bdc5d95823a96316ba8
KUBECTL_LINUX_AMD64_SHA256=874d5e72dbb819f43cff16bcd1e4f8bac5b7f2361fe1e55049b0a6c676fb0cbf

# Helm is pinned so `helm template` output is byte-stable for the drift gate.
HELM_VERSION=v3.19.0
HELM_WINDOWS_AMD64_SHA256=6488630c2e5d5945ed990fa02fd9e99f9c6792cdbcd79eb264b6cfb90179d2d1
HELM_LINUX_AMD64_SHA256=a7f81ce08007091b86d8bd696eb4d86b8d0f2e1b9f6c714be62f82f96a594496

# Standalone kustomize. The primary renderer is kubectl's embedded kustomize.
KUSTOMIZE_VERSION=v5.7.1
KUSTOMIZE_WINDOWS_AMD64_SHA256=4704f8b47582c1c52bf76a50b37178f7f7de17f892713794a8bf44b01b50e0ce

# Schema validation. `--ignore-missing-schemas` is intentionally NOT used.
KUBECONFORM_VERSION=v0.7.0
KUBECONFORM_WINDOWS_AMD64_SHA256=9cb75551d81c909c2241ab383ced2be68363b5bfb15fd989badcc5a63bea5d7e
KUBECONFORM_LINUX_AMD64_SHA256=c31518ddd122663b3f3aa874cfe8178cb0988de944f29c74a0b9260920d115d3

# Policy tests.
CONFTEST_VERSION=v0.68.2
CONFTEST_WINDOWS_AMD64_SHA256=66a88d02e6c03a714e9f0751c3d86ee9c5591739c367ca1b79c4f9f2f90ac4cb
CONFTEST_LINUX_AMD64_SHA256=e8144c6d6d2ae0260b869caa60c7c262a1f95ac63ec1e5d2fb19be452d606347
